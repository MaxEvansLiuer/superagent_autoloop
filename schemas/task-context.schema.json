{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/task-context.schema.json",
  "title": "Codex Idea to Delivery task context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "taskId",
    "goal",
    "nonGoals",
    "approvedScope",
    "baseline",
    "repository",
    "acceptanceChecks",
    "workers",
    "decisionGates"
  ],
  "properties": {
    "version": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "approvedScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "facts", "checks"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "facts": { "type": "array", "items": { "type": "string" } },
        "checks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "worktree", "branch"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "enum": ["github", "gitlab"] }
      }
    },
    "acceptanceChecks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "workers": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "assignment", "fileAllowlist", "dependsOn", "interfaces", "deliverables"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "assignment": { "type": "string", "minLength": 1 },
          "fileAllowlist": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "interfaces": { "type": "array", "items": { "type": "string" } },
          "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "decisionGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notifyUserWhen", "autoRouteWhen"],
      "properties": {
        "notifyUserWhen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "autoRouteWhen": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
